{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RipDaddy",
  "version": "0.1.0",
  "identifier": "com.ripdaddy.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RipDaddy",
        "width": 1240,
        "height": 780,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**/*",
          "$CACHE/**/*",
          "$LOCALDATA/**/*",
          "$TEMP/**/*",
          "$VIDEO/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4MjYzNjQxN0M4MjY3MTEKUldRUlo0SjhRVFltU0xHRmUyTVF6eXgyUmxCaHljM0VXbEN0ODh0a2oyV0tCK3FIOGJFMk91ZmYK",
      "endpoints": [
        "https://github.com/swindsor8/RipDaddy/releases/latest/download/latest.json"
      ]
    }
  }
}
